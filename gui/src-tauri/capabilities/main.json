{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The workbench window may invoke the app's own commands and nothing from Tauri's core plugins: no window, event, path or webview API. The list must match COMMANDS in build.rs.",
  "windows": ["main"],
  "permissions": [
    "allow-open-document",
    "allow-check-buffer",
    "allow-scan",
    "allow-not-checked",
    "allow-glyph-markers",
    "allow-coverage-for",
    "allow-rule-detail",
    "allow-set-triage",
    "allow-stale-triage",
    "allow-set-baseline",
    "allow-baseline-info",
    "allow-assign-finding",
    "allow-comment-on-finding",
    "allow-plan",
    "allow-terminal-start",
    "allow-terminal-write",
    "allow-terminal-read",
    "allow-terminal-resize"
  ]
}
